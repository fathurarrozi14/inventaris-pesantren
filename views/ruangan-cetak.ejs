<%- include('partials/head', { page: 'laporan' }) %>
<%
const ST_LABEL = { tersedia: 'Tersedia', dipakai: 'Dipakai', maintenance: 'Maintenance' };
%>
<div class="toolbar no-print">
  <a class="btn btn-ghost" href="<%- url('ruangan') %>">← Kembali</a>
  <button type="button" class="btn" onclick="window.print()">🖨 Cetak / Simpan PDF</button>
  <a class="btn btn-ghost" href="<%- url('ruangan/excel') %>">⬇ Download Excel (CSV)</a>
</div>

<div class="print-header">
  <% if (logoData) { %>
  <img class="ph-logo ph-logo-img" src="<%- logoData %>" alt="Logo">
  <% } else { %>
  <svg class="ph-logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path fill="#6366F1" d="M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z"/>
    <rect x="8" y="33" width="32" height="4" rx="2" fill="#8B5CF6"/>
    <rect x="4" y="38" width="40" height="5" rx="2.5" fill="#6366F1"/>
    <rect x="6" y="24" width="3" height="12" rx="1.5" fill="#E8C46A"/>
    <rect x="39" y="24" width="3" height="12" rx="1.5" fill="#E8C46A"/>
  </svg>
  <% } %>
  <div class="ph-text">
    <h2>PESANTREN SAHABATQU</h2>
    <p>Bagian Sarana &amp; Prasarana · Sistem Inventaris</p>
    <h3>Daftar Ruangan &amp; Fasilitas</h3>
    <span class="ph-date">Per <%= fmtDate(today()) %> · Dicetak <%= fmtDate(today()) %> oleh <%= u.nama %></span>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>No</th><th>Ruangan</th><th>Golongan</th><th>Bidang</th><th>Kode Aset</th><th>Lokasi</th><th>Kapasitas</th><th>Status</th></tr>
      </thead>
      <tbody>
        <% if (list.length === 0) { %>
        <tr><td colspan="8" class="empty-cell">Belum ada data ruangan.</td></tr>
        <% } %>
        <% list.forEach((r, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= r.nama %></strong><% if (r.deskripsi) { %><div class="cell-sub"><%= r.deskripsi %></div><% } %></td>
          <td><%= r.golongan || '—' %></td>
          <td><%= r.bidang_aset || '—' %></td>
          <td><% if (r.kode_aset) { %><strong><%= kodeAset(r.golongan, r.bidang_aset, r.kode_aset) %></strong> <span class="cell-sub"><%= subNama(r.kode_aset) %></span><% } else { %>—<% } %></td>
          <td><%= r.lokasi || '—' %></td>
          <td><%= r.kapasitas %> orang</td>
          <td><%- badge(r.status, 'ruangan') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="signature print-only">
  <div class="sig-block">
    <p class="sig-role">Dicetak oleh,</p>
    <p class="sig-name"><strong><%= u.nama %></strong></p>
    <p class="sig-sub"><%= roleLabel(u.role) %> · Pesantren SahabatQu</p>
  </div>
  <div class="sig-block">
    <p class="sig-role">Mengetahui,<br>Kepala Sarana &amp; Prasarana</p>
    <p class="sig-name">( &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; )</p>
  </div>
</div>

<%- include('partials/foot') %>
