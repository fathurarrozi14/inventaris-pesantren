<script>
(function () {
  // ---------- Tema terang/gelap ----------
  var toggle = document.getElementById('themeToggle');
  if (toggle) {
    toggle.addEventListener('click', function () {
      var cur = document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
      var next = cur === 'light' ? 'dark' : 'light';
      document.documentElement.setAttribute('data-theme', next);
      try { localStorage.setItem('sq-theme', next); } catch (e) {}
    });
  }

  // ---------- Tombol WhatsApp: 2 pilihan nomor ----------
  var waBtn = document.getElementById('waBtn');
  var waPop = document.getElementById('waPop');
  if (waBtn && waPop) {
    waBtn.addEventListener('click', function (e) { e.stopPropagation(); waPop.classList.toggle('open'); });
    document.addEventListener('click', function () { waPop.classList.remove('open'); });
  }

  // ---------- Bismillah: disesuaikan dengan judul hero ----------
  // Dihitung dari lebar teks sesungguhnya (bukan angka tetap) supaya tetap pas
  // walau judul hero diubah admin lewat "Halaman Website" atau lebar layar berbeda.
  //
  // PENTING: huruf Amiri (dengan harakat) tingginya ~1,95x ukuran font, sedangkan
  // judul Latin hanya ~0,85x. Jadi menyamakan LEBAR 100% membuat tulisan Arab
  // tampak ~3x lebih tinggi dari judul (terlalu besar). Karena itu:
  //   LEBAR_JUDUL     = berapa persen lebar judul yang mau disamai (0.70 = 70%)
  //   BATAS_TINGGI    = tinggi tulisan maksimal, dihitung dari tinggi visual judul
  // Ubah dua angka ini saja kalau ingin lebih besar/kecil.
  var LEBAR_JUDUL = 0.70;
  var BATAS_TINGGI = 2.6;
  (function () {
    var bi = document.querySelector('.fx-bismillah');
    var h1 = document.querySelector('.fx-hero h1');
    if (!bi || !h1) return;

    function lebarTeks(el) {
      var rg = document.createRange();
      rg.selectNodeContents(el);
      var rects = rg.getClientRects(), maks = 0;
      for (var i = 0; i < rects.length; i++) if (rects[i].width > maks) maks = rects[i].width;
      return maks;
    }
    // tinggi "tinta" huruf asli (tanpa ruang kosong baris) / ukuran font
    function rasioTinggi(el) {
      var c = document.createElement('canvas'), x = c.getContext('2d');
      var cs = getComputedStyle(el);
      x.font = cs.fontStyle + ' ' + cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
      var m = x.measureText(el.textContent.trim() || 'A');
      return (m.actualBoundingBoxAscent + m.actualBoundingBoxDescent) / parseFloat(cs.fontSize) || 0.85;
    }

    function pas() {
      bi.style.fontSize = '';                      // kembali ke ukuran dasar dari CSS
      var dasar = parseFloat(getComputedStyle(bi).fontSize);
      if (!dasar) return;
      var wBi = lebarTeks(bi), wH1 = lebarTeks(h1);
      if (!wBi || !wH1) return;
      // batas 1: lebar tidak melebihi LEBAR_JUDUL x lebar judul
      var olehLebar = dasar * (wH1 * LEBAR_JUDUL / wBi);
      // batas 2: tinggi huruf tidak melebihi BATAS_TINGGI x tinggi huruf judul
      var h1Font = parseFloat(getComputedStyle(h1).fontSize);
      var rb = rasioTinggi(bi), rh = rasioTinggi(h1);
      var olehTinggi = (rh * h1Font * BATAS_TINGGI) / rb;
      var target = Math.min(olehLebar, olehTinggi);
      var maks = dasar * (bi.clientWidth / wBi) * 0.995; // jangan sampai meluber / pindah baris
      target = Math.max(15, Math.min(target, maks, 140));
      if (target < dasar) target = dasar;          // jangan sampai lebih kecil dari ukuran dasar
      bi.style.fontSize = target.toFixed(2) + 'px';
    }

    // Ukuran huruf asli baru diketahui setelah webfont (Amiri/Jakarta) selesai
    // dimuat — Google Fonts di sini dimuat non-blocking, jadi dihitung ulang
    // saat font siap + beberapa kali sebagai jaring pengaman.
    pas();
    [150, 600, 1800, 3500].forEach(function (ms) { setTimeout(pas, ms); });
    if (document.fonts) {
      if (document.fonts.ready) document.fonts.ready.then(pas);
      if (document.fonts.addEventListener) {
        document.fonts.addEventListener('loadingdone', pas);
        document.fonts.addEventListener('loadingerror', pas);
      }
    }
    window.addEventListener('load', pas);
    var t = null;
    window.addEventListener('resize', function () { clearTimeout(t); t = setTimeout(pas, 120); });
  })();

  // ---------- Pencarian jadwal peminjaman (filter langsung tanpa muat ulang) ----------
  // Kotak pencarian di hero menyaring kartu jadwal (ruangan & mobil) menurut nama
  // ruangan/mobil, keperluan, nama peminjam, bidang, dan tanggal. Tanpa JS, form
  // tetap mengirim ?q= ke server (hasil sama, halaman dimuat ulang).
  (function () {
    var form = document.getElementById('cariJadwal');
    var input = document.getElementById('cariJadwalInput');
    var clear = document.getElementById('cariJadwalClear');
    var note = document.getElementById('cariJadwalNote');
    if (!form || !input) return;
    var panels = document.querySelectorAll('[data-fx-panel]');
    var tabs = document.querySelectorAll('[data-fx-tab]');

    function tampilkanPanel(kunci) {
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-fx-panel') !== kunci; });
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-fx-tab') === kunci;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function terapkan() {
      var teks = input.value.trim();
      var q = teks.toLowerCase();
      if (clear) clear.hidden = teks === '';
      var jumlah = {}, total = 0;
      panels.forEach(function (p) {
        var kunci = p.getAttribute('data-fx-panel'), n = 0;
        p.querySelectorAll('.fx-sched').forEach(function (kartu) {
          var cocok = q === '' || kartu.textContent.toLowerCase().indexOf(q) !== -1;
          kartu.hidden = !cocok;
          if (cocok) n++;
        });
        jumlah[kunci] = n;
        total += n;
        var kosong = p.querySelector('.fx-cari-empty');
        if (kosong) kosong.hidden = !(q !== '' && n === 0);
      });
      tabs.forEach(function (t) {
        var s = t.querySelector('.n'), k = t.getAttribute('data-fx-tab');
        if (s && jumlah[k] !== undefined) s.textContent = jumlah[k];
      });
      // kalau tab yang sedang aktif jadi kosong, pindah ke tab yang ada isinya
      if (q !== '') {
        var aktif = document.querySelector('.fx-tab.is-on');
        var ka = aktif ? aktif.getAttribute('data-fx-tab') : 'ruangan';
        if (jumlah[ka] === 0) {
          var lain = Object.keys(jumlah).filter(function (k) { return jumlah[k] > 0; })[0];
          if (lain) tampilkanPanel(lain);
        } else {
          tampilkanPanel(ka);
        }
      }
      if (note) {
        note.textContent = '';
        if (teks === '') { note.hidden = true; return; }
        note.hidden = false;
        if (total === 0) {
          note.textContent = 'Tidak ada jadwal yang cocok dengan “' + teks + '”.';
        } else {
          var b = document.createElement('strong'); b.textContent = total;
          note.appendChild(b);
          note.appendChild(document.createTextNode(' jadwal cocok dengan “' + teks + '” — '));
          var a = document.createElement('a'); a.href = '#jadwal'; a.textContent = 'lihat daftarnya';
          note.appendChild(a);
        }
      }
    }

    input.addEventListener('input', terapkan);
    input.addEventListener('search', terapkan);           // tombol ✕ bawaan input search
    form.addEventListener('submit', function (e) {        // JS aktif: cukup saring di tempat
      e.preventDefault();
      terapkan();
      var sasaran = document.getElementById('jadwal');
      if (sasaran && input.value.trim() !== '') sasaran.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    if (clear) clear.addEventListener('click', function () {
      input.value = '';
      terapkan();
      input.focus();
    });
    terapkan();
  })();

  // ---------- Tab jadwal: Ruangan / Mobil ----------
  var tabs = document.querySelectorAll('[data-fx-tab]');
  var panels = document.querySelectorAll('[data-fx-panel]');
  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      var kunci = tab.getAttribute('data-fx-tab');
      tabs.forEach(function (t) {
        var on = t === tab;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach(function (p) { p.hidden = p.getAttribute('data-fx-panel') !== kunci; });
    });
  });

  // ---------- Bottom sheet peminjaman ----------
  var fab = document.getElementById('fxFab');
  var sheet = document.getElementById('fxSheet');
  var sheetClose = document.getElementById('fxSheetClose');
  function tutupSheet() { if (sheet) sheet.classList.remove('open'); }
  if (fab && sheet) {
    fab.addEventListener('click', function () { sheet.classList.toggle('open'); });
    sheet.addEventListener('click', function (e) { if (e.target === sheet) tutupSheet(); });
  }
  if (sheetClose) sheetClose.addEventListener('click', tutupSheet);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') tutupSheet(); });

  // ---------- Dock: tandai menu aktif sesuai bagian yang terlihat ----------
  var items = document.querySelectorAll('[data-fx-nav]');
  var bagian = ['beranda', 'jadwal', 'inventaris', 'kontak'];
  function aktifkan(id) {
    items.forEach(function (it) { it.classList.toggle('is-on', it.getAttribute('data-fx-nav') === id); });
  }
  if ('IntersectionObserver' in window) {
    var terlihat = {};
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting) terlihat[en.target.id] = en.intersectionRatio;
        else delete terlihat[en.target.id];
      });
      var terpilih = null, maks = 0;
      bagian.forEach(function (id) {
        if ((terlihat[id] || 0) > maks) { maks = terlihat[id]; terpilih = id; }
      });
      if (terpilih) aktifkan(terpilih);
    }, { threshold: [0.15, 0.4, 0.75], rootMargin: '-10% 0px -25% 0px' });
    bagian.forEach(function (id) {
      var el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }
})();

/* Info Inventaris: sekali klik menampilkan rincian jumlah, setelah itu nonaktif */
var modalInventaris = document.getElementById('modalInventaris');
window.lihatJumlah = function (el) {
  if (!el || el.classList.contains('seen')) return; // hanya 1x klik
  document.querySelectorAll('.stat-once').forEach(function (c) { c.classList.add('seen'); });
  el.classList.remove('seen');
  if (modalInventaris) modalInventaris.hidden = false;
};
window.tutupJumlah = function () { if (modalInventaris) modalInventaris.hidden = true; };
if (modalInventaris) {
  modalInventaris.addEventListener('click', function (e) { if (e.target === modalInventaris) modalInventaris.hidden = true; });
}
</script>
</body>
</html>
