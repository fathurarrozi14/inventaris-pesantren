<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title><%= e(set.hero_title || 'Pesantren SahabatQu') %> — Sistem Inventaris, Peminjaman &amp; Pemeliharaan</title>
<% if (logoData) { %>
<link rel="icon" href="<%- url('logo') %>">
<% } else { %>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236366F1'/%3E%3Cstop offset='1' stop-color='%238B5CF6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath fill='url(%23g)' d='M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z'/%3E%3Crect x='8' y='33' width='32' height='4' rx='2' fill='%238B5CF6'/%3E%3Crect x='4' y='38' width='40' height='5' rx='2.5' fill='%236366F1'/%3E%3Crect x='6' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3Crect x='39' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3C/svg%3E">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet"></noscript>
<script>
(function () {
  // Beranda website didesain gelap (dark navy premium) — default 'dark' walau
  // perangkat pengguna memilih tema terang. Pilihan manual via tombol 🌙/☀️ tetap dihormati.
  var s = null;
  try { s = localStorage.getItem('sq-theme'); } catch (e) {}
  document.documentElement.setAttribute('data-theme', s || 'dark');
})();
</script>
<link rel="stylesheet" href="style.css?v=18">
<link rel="icon" type="image/png" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="icon" type="image/png" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<link rel="manifest" href="<%- url('manifest.webmanifest') %>">
<meta name="theme-color" content="#04081C">
<link rel="apple-touch-icon" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="apple-touch-icon" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SINTAPQU">
<script src="<%- url('pwa.js?v=6') %>" defer></script>
</head>
<%
/* ---- Data jadwal gabungan (ruangan + mobil) untuk hero & seksi fokus ---- */
const NAMA_HARI = ['Minggu','Senin','Selasa','Rabu','Kamis','Jumat','Sabtu'];
const NAMA_BULAN = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des'];
function chipTanggal(t) {
  const d = new Date(String(t) + 'T00:00:00');
  if (isNaN(d.getTime())) return { hari: '', tgl: '--', bulan: '', tahun: '' };
  return { hari: NAMA_HARI[d.getDay()], tgl: d.getDate(), bulan: NAMA_BULAN[d.getMonth()], tahun: d.getFullYear() };
}
const jadwalRuangan = pinjamPublik.map((p) => ({
  tipe: 'ruangan',
  nama: p.ruangan_nama,
  keperluan: p.keperluan,
  mulai: p.tanggal_mulai,
  selesai: p.tanggal_selesai,
  jam1: p.jam_mulai || '08:00',
  jam2: p.jam_selesai || '17:00',
  info: p.jumlah_peserta ? p.jumlah_peserta + ' peserta' : '',
  orang: p.peminjam_tampil,
  extra: p.bidang_tampil || '',
  link: 'peminjaman-ruangan'
}));
const jadwalMobil = pinjamMobilPublik.map((p) => ({
  tipe: 'mobil',
  nama: p.mobil_nama + (p.mobil_plat ? ' · ' + p.mobil_plat : ''),
  keperluan: p.keperluan,
  mulai: p.tanggal_mulai,
  selesai: p.tanggal_selesai,
  jam1: p.jam_mulai || '08:00',
  jam2: p.jam_selesai || '17:00',
  info: p.jumlah_penumpang ? p.jumlah_penumpang + ' penumpang' : '',
  orang: p.peminjam_tampil,
  extra: p.mobil_jenis || '',
  link: 'peminjaman-mobil'
}));
const jadwalSemua = jadwalRuangan.concat(jadwalMobil)
  .sort((a, b) => (a.mulai + a.jam1).localeCompare(b.mulai + b.jam1));
const jadwalTerdekat = jadwalSemua.slice(0, 3);
const totalJadwal = jadwalSemua.length;
%>
<body class="fx-body">
<div class="fx-bg" aria-hidden="true">
  <span class="fx-blob fx-blob-1"></span>
  <span class="fx-blob fx-blob-2"></span>
  <span class="fx-blob fx-blob-3"></span>
  <span class="fx-blob fx-blob-4"></span>
  <span class="fx-grid"></span>
</div>

<div class="fx-shell">

<!-- ============ TOP BAR ============ -->
<header class="fx-topbar">
  <a class="fx-brand" href="#beranda">
    <span class="fx-logo">
      <% if (logoData) { %>
      <img src="<%- url('logo') %>" alt="Logo Pesantren">
      <% } else { %>
      <svg viewBox="0 0 48 48" fill="none" aria-hidden="true">
        <path fill="#fff" d="M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z" opacity=".95"/>
        <rect x="8" y="33" width="32" height="4" rx="2" fill="#fff" opacity=".8"/>
        <rect x="4" y="38" width="40" height="5" rx="2.5" fill="#fff" opacity=".6"/>
        <rect x="6" y="24" width="3" height="12" rx="1.5" fill="#F5D98B"/>
        <rect x="39" y="24" width="3" height="12" rx="1.5" fill="#F5D98B"/>
      </svg>
      <% } %>
    </span>
    <span class="fx-brand-text">
      <strong><%= e(set.header_brand || 'Pesantren SahabatQu') %></strong>
      <span><%= e(set.header_tagline || 'Sistem Inventaris, Peminjaman & Pemeliharaan') %></span>
    </span>
  </a>
  <div class="fx-top-actions">
    <button type="button" class="theme-toggle" id="themeToggle" aria-label="Ganti tema terang/gelap" title="Ganti tema terang/gelap">
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <% if (u) { %>
    <a class="fx-icon-btn" href="index" title="Dashboard" aria-label="Dashboard">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.6"/><rect x="14" y="3" width="7" height="5" rx="1.6"/><rect x="14" y="12" width="7" height="9" rx="1.6"/><rect x="3" y="16" width="7" height="5" rx="1.6"/></svg>
    </a>
    <a class="fx-btn sm ghost" href="logout">Keluar</a>
    <% } else { %>
    <a class="fx-btn sm" href="login"><%= e(set.btn_login || 'Masuk') %></a>
    <% } %>
  </div>
</header>

<main class="fx-main">

  <!-- ============ HERO ============ -->
  <section class="fx-hero" id="beranda">
    <div class="fx-hero-grid">
      <div class="fx-hero-left">
        <% if (set.hero_badge) { %><span class="fx-hero-badge">✦ <%= e(set.hero_badge) %></span><% } %>
        <p class="fx-bismillah">بِسْمِ اللّٰهِ الرَّحْمٰنِ الرَّحِيْمِ</p>
        <h1><%= e(set.hero_title || 'Pesantren SahabatQu') %></h1>
        <% if (set.hero_sub) { %><p class="fx-hero-sub"><%= e(set.hero_sub) %></p><% } %>
        <div class="fx-cta">
          <% if (u) { %>
          <a class="fx-btn" href="index">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.6"/><rect x="14" y="3" width="7" height="5" rx="1.6"/><rect x="14" y="12" width="7" height="9" rx="1.6"/><rect x="3" y="16" width="7" height="5" rx="1.6"/></svg>
            Buka Dashboard
          </a>
          <% } else { %>
          <a class="fx-btn" href="login">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>
            <%= e(set.btn_login || 'Masuk ke Sistem Inventaris') %>
          </a>
          <a class="fx-btn ghost" href="register"><%= e(set.btn_register || 'Daftar Akun Baru') %></a>
          <% } %>
        </div>

        <form class="fx-search" method="get" action="" id="cariJadwal" role="search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input type="search" name="q" id="cariJadwalInput" value="<%= cari %>"
                 placeholder="Cari jadwal — ruangan, mobil, kegiatan, atau nama peminjam"
                 aria-label="Cari jadwal peminjaman" autocomplete="off">
          <button type="button" class="fx-search-clear" id="cariJadwalClear" aria-label="Hapus pencarian" title="Hapus pencarian" hidden>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
          </button>
          <button type="submit" class="fx-btn sm">Cari</button>
        </form>
        <p class="fx-search-note" id="cariJadwalNote"<%= cari ? '' : ' hidden' %>><% if (cari) { %><% if (jumlahCari === 0) { %>Tidak ada jadwal yang cocok dengan &ldquo;<%= cari %>&rdquo;.<% } else { %><strong><%= jumlahCari %></strong> jadwal cocok dengan &ldquo;<%= cari %>&rdquo; — <a href="#jadwal">lihat daftarnya</a><% } %><% } %></p>
        <p class="fx-search-hint">Butuh cek kode stiker barang? <a href="scan-qr">Scan QR / cek kode</a> · <a href="inventaris">daftar inventaris</a></p>

        <div class="fx-quick">
          <a class="fx-chip" href="scan-qr">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
            Scan QR
          </a>
          <a class="fx-chip" href="peminjaman-ruangan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            Pinjam Ruangan
          </a>
          <a class="fx-chip" href="peminjaman-mobil">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14M6 17V9.5L7.6 5h8.8L18 9.5V17"/><path d="M6 9.5h12"/><circle cx="7.5" cy="17" r="1.6"/><circle cx="16.5" cy="17" r="1.6"/></svg>
            Pinjam Mobil
          </a>
          <% if (waMaint) { %>
          <a class="fx-chip" href="https://wa.me/<%= waMaint %>?text=<%= encodeURIComponent('Assalamualaikum, saya ingin melaporkan kerusakan / pemeliharaan fasilitas.') %>" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            Lapor Kerusakan
          </a>
          <% } else { %>
          <a class="fx-chip" href="#maintenance">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            Pemeliharaan
          </a>
          <% } %>
        </div>
        <% if (set.hero_note) { %><p class="fx-hero-note"><%= e(set.hero_note) %></p><% } %>
      </div>

      <aside class="fx-hero-right">
        <div class="fx-glass">
          <div class="fx-glass-head">
            <span class="fx-dot"></span>
            <h3>Jadwal Terdekat</h3>
            <span class="fx-count"><%= totalJadwal %> jadwal aktif</span>
          </div>
          <% if (jadwalTerdekat.length === 0) { %>
          <div class="fx-empty"><%= cari ? 'Tidak ada jadwal yang cocok dengan pencarian.' : 'Belum ada jadwal peminjaman yang disetujui.' %></div>
          <% } else { %>
          <div class="fx-mini-list">
            <% jadwalTerdekat.forEach(j => { const c = chipTanggal(j.mulai); %>
            <div class="fx-mini">
              <span class="fx-mini-date"><b><%= c.tgl %></b><i><%= c.bulan %></i></span>
              <span class="fx-mini-body">
                <strong><%= j.nama %></strong>
                <span class="fx-mini-keperluan"><%= j.keperluan || '—' %></span>
                <span><%= j.jam1 %>–<%= j.jam2 %> WIB · <%= j.tipe === 'mobil' ? 'Mobil' : 'Ruangan' %> · <%= j.orang %></span>
              </span>
            </div>
            <% }) %>
          </div>
          <% } %>
          <a class="fx-link" href="#jadwal">Lihat semua jadwal →</a>
        </div>
        <% if (set.hero_image) { %>
        <div class="fx-hero-photo"><img src="<%- e(set.hero_image) %>" alt="Foto pesantren" loading="lazy" decoding="async"></div>
        <% } %>
      </aside>
    </div>

  </section>

  <!-- ============ JADWAL PEMINJAMAN (fokus utama) ============ -->
  <section class="fx-section" id="jadwal">
    <div class="fx-section-head">
      <div>
        <span class="fx-eyebrow">Fokus Utama</span>
        <h2 class="fx-h2">Jadwal Peminjaman</h2>
        <p class="fx-sub">Peminjaman ruangan &amp; kendaraan yang sudah disetujui, diurutkan dari tanggal terdekat — terbuka untuk umum.</p>
      </div>
      <div class="fx-tabs" role="tablist" aria-label="Pilih jenis jadwal">
        <button type="button" class="fx-tab is-on" data-fx-tab="ruangan" role="tab" aria-selected="true">
          Ruangan <span class="n"><%= jadwalRuangan.length %></span>
        </button>
        <button type="button" class="fx-tab" data-fx-tab="mobil" role="tab" aria-selected="false">
          Mobil <span class="n"><%= jadwalMobil.length %></span>
        </button>
      </div>
    </div>

    <div class="fx-panel" data-fx-panel="ruangan">
      <% if (jadwalRuangan.length === 0) { %>
      <div class="fx-empty"><%= cari ? 'Tidak ada jadwal ruangan yang cocok dengan pencarian.' : 'Belum ada jadwal peminjaman ruangan saat ini.' %></div>
      <% } else { %>
      <div class="fx-empty fx-cari-empty" hidden>Tidak ada jadwal ruangan yang cocok dengan pencarian.</div>
      <div class="fx-sched-grid">
        <% jadwalRuangan.forEach(j => { const c = chipTanggal(j.mulai); %>
        <article class="fx-sched">
          <span class="fx-sched-date"><b><%= c.tgl %></b><i><%= c.bulan %></i><u><%= c.hari %> <%= c.tahun %></u></span>
          <div class="fx-sched-main">
            <div class="fx-sched-top">
              <span class="fx-sched-name"><%= j.nama %></span>
              <span class="fx-tag ruang">Ruangan</span>
            </div>
            <p class="fx-sched-keperluan"><%= j.keperluan %></p>
            <div class="fx-sched-meta">
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><%= fmtDateShort(j.mulai) %> – <%= fmtDateShort(j.selesai) %></span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><%= j.jam1 %>–<%= j.jam2 %> WIB</span>
              <% if (j.info) { %>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg><%= j.info %></span>
              <% } %>
            </div>
            <div class="fx-sched-org">👤 Peminjam: <strong><%= j.orang %></strong><% if (j.extra) { %> · <%= j.extra %><% } %></div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>

    <div class="fx-panel" data-fx-panel="mobil" hidden>
      <% if (jadwalMobil.length === 0) { %>
      <div class="fx-empty"><%= cari ? 'Tidak ada jadwal mobil yang cocok dengan pencarian.' : 'Belum ada jadwal peminjaman mobil saat ini.' %></div>
      <% } else { %>
      <div class="fx-empty fx-cari-empty" hidden>Tidak ada jadwal mobil yang cocok dengan pencarian.</div>
      <div class="fx-sched-grid">
        <% jadwalMobil.forEach(j => { const c = chipTanggal(j.mulai); %>
        <article class="fx-sched">
          <span class="fx-sched-date mobil"><b><%= c.tgl %></b><i><%= c.bulan %></i><u><%= c.hari %> <%= c.tahun %></u></span>
          <div class="fx-sched-main">
            <div class="fx-sched-top">
              <span class="fx-sched-name"><%= j.nama %></span>
              <span class="fx-tag mobil">Mobil</span>
            </div>
            <p class="fx-sched-keperluan"><%= j.keperluan %></p>
            <div class="fx-sched-meta">
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><%= fmtDateShort(j.mulai) %> – <%= fmtDateShort(j.selesai) %></span>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><%= j.jam1 %>–<%= j.jam2 %> WIB</span>
              <% if (j.info) { %>
              <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/></svg><%= j.info %></span>
              <% } %>
            </div>
            <div class="fx-sched-org">👤 Peminjam: <strong><%= j.orang %></strong><% if (j.extra) { %> · <%= j.extra %><% } %></div>
          </div>
        </article>
        <% }) %>
      </div>
      <% } %>
    </div>

    <div class="fx-quick" style="margin-top:22px">
      <a class="fx-chip" href="peminjaman-ruangan">＋ Ajukan Pinjam Ruangan</a>
      <a class="fx-chip" href="peminjaman-mobil">＋ Ajukan Pinjam Mobil</a>
      <a class="fx-chip" href="peminjaman-barang">＋ Ajukan Pinjam Barang</a>
    </div>
  </section>

  <!-- ============ PEMELIHARAAN ============ -->
  <section class="fx-section" id="maintenance">
    <span class="fx-eyebrow">Status Fasilitas</span>
    <h2 class="fx-h2"><%= e(set.title_maintenance || 'Pemeliharaan Sedang Berjalan') %></h2>
    <p class="fx-sub"><%= e(set.sub_maintenance || 'Fasilitas yang sedang dalam perawatan. Perkembangan lengkap dapat dipantau setelah masuk.') %></p>
    <% if (maint.length === 0) { %>
    <div class="fx-empty" style="margin-top:22px">Alhamdulillah, saat ini tidak ada fasilitas dalam pemeliharaan.</div>
    <% } else { %>
    <div class="fx-maint-grid">
      <% maint.forEach(m => { %>
      <article class="fx-maint">
        <div class="fx-maint-top">
          <span class="fx-maint-name"><%= m.objek_nama %></span>
          <span class="kat kat-<%= m.kategori %>"><%= kategoriLabel(m.kategori) %></span>
        </div>
        <p class="fx-maint-judul"><%= m.judul %></p>
        <div class="fx-maint-meta">
          <span class="lvl lvl-<%= m.tingkat %>"><%= m.tingkat %></span>
          <%- badge(m.status, 'maintenance') %>
          <span>sejak <%= fmtDateShort(m.tanggal_lapor) %></span>
        </div>
        <% if (m.penanggung_jawab) { %><div class="fx-maint-org">🛠️ PIC: <strong><%= m.penanggung_jawab %></strong></div><% } %>
        <% if (m.pelapor_nama) { %><div class="fx-maint-org">👤 Pelapor: <strong><%= m.pelapor_nama %></strong></div><% } %>
      </article>
      <% }) %>
    </div>
    <% } %>
  </section>

  <!-- ============ INVENTARIS ============ -->
  <section class="fx-section" id="inventaris">
    <span class="fx-eyebrow">Data Inventaris</span>
    <h2 class="fx-h2"><%= e(set.title_inventaris || 'Info Inventaris') %></h2>
    <p class="fx-sub"><%= e(set.sub_inventaris || 'Ringkasan inventaris Pesantren SahabatQu saat ini.') %></p>
    <div class="fx-tiles">
      <button type="button" class="fx-tile stat-once" onclick="lihatJumlah(this)">
        <span class="fx-tile-ico t1"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12.6 2.6A2 2 0 0 0 11.2 2H4a2 2 0 0 0-2 2v7.2a2 2 0 0 0 .6 1.4l8.7 8.7a2.4 2.4 0 0 0 3.4 0l6.6-6.6a2.4 2.4 0 0 0 0-3.4z"/><circle cx="7.5" cy="7.5" r="1.1"/></svg></span>
        <b><%= stats.barangJenis %></b>
        <span>Jenis Barang</span>
        <small>klik 1× untuk lihat rincian jumlah</small>
      </button>
      <button type="button" class="fx-tile stat-once" onclick="lihatJumlah(this)">
        <span class="fx-tile-ico t2"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 2 9 4.5-9 4.5-9-4.5z"/><path d="m3 11.5 9 4.5 9-4.5"/><path d="m3 16.5 9 4.5 9-4.5"/></svg></span>
        <b><%= stats.stokTotal.toLocaleString('id-ID') %></b>
        <span>Total Stok</span>
        <small>klik 1× untuk lihat rincian jumlah</small>
      </button>
      <button type="button" class="fx-tile stat-once" onclick="lihatJumlah(this)">
        <span class="fx-tile-ico t3"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 21V6a1 1 0 0 1 1-1h9a1 1 0 0 1 1 1v15"/><path d="M15 11h4a1 1 0 0 1 1 1v9"/><path d="M2 21h20"/><path d="M8 9h3M8 13h3M8 17h3M18 15v.01M18 18v.01"/></svg></span>
        <b><%= stats.ruangan %></b>
        <span>Ruangan Terdaftar</span>
        <small>masjid · aula · kelas · asrama</small>
      </button>
      <button type="button" class="fx-tile stat-once" onclick="lihatJumlah(this)">
        <span class="fx-tile-ico t4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3.2"/><path d="M19.4 15a1.7 1.7 0 0 0 .34 1.87l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.7 1.7 0 0 0-1.87-.34 1.7 1.7 0 0 0-1.03 1.56V21a2 2 0 1 1-4 0v-.09a1.7 1.7 0 0 0-1.11-1.56 1.7 1.7 0 0 0-1.87.34l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.7 1.7 0 0 0 .34-1.87 1.7 1.7 0 0 0-1.56-1.03H3a2 2 0 1 1 0-4h.09A1.7 1.7 0 0 0 4.65 9a1.7 1.7 0 0 0-.34-1.87l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.7 1.7 0 0 0 9 4.65a1.7 1.7 0 0 0 1.03-1.56V3a2 2 0 1 1 4 0v.09A1.7 1.7 0 0 0 15.06 4.65a1.7 1.7 0 0 0 1.87-.34l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.7 1.7 0 0 0 19.35 9v.09a1.7 1.7 0 0 0 1.56 1.03H21a2 2 0 1 1 0 4h-.09a1.7 1.7 0 0 0-1.51.88z"/></svg></span>
        <b><%= stats.maintBerjalan %></b>
        <span>Pemeliharaan Berjalan</span>
        <small><%= stats.maintSelesai %> selesai</small>
      </button>
    </div>
  </section>

  <% if (set.about_title || set.about_text) { %>
