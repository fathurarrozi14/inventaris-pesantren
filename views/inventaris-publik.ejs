<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title>Inventaris — Pesantren SahabatQu</title>
<% if (logoData) { %>
<link rel="icon" href="<%- url('logo') %>">
<% } else { %>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236366F1'/%3E%3Cstop offset='1' stop-color='%238B5CF6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath fill='url(%23g)' d='M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z'/%3E%3Crect x='8' y='33' width='32' height='4' rx='2' fill='%238B5CF6'/%3E%3Crect x='4' y='38' width='40' height='5' rx='2.5' fill='%236366F1'/%3E%3Crect x='6' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3Crect x='39' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3C/svg%3E">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css?v=18">
<link rel="icon" type="image/png" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="icon" type="image/png" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<link rel="manifest" href="<%- url('manifest.webmanifest') %>">
<meta name="theme-color" content="#4F46E5">
<link rel="apple-touch-icon" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="apple-touch-icon" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SINTAPQU">
<script src="<%- url('pwa.js?v=6') %>" defer></script>
</head>
<body class="login-body" style="align-items:flex-start;padding:24px">
<div class="bg" aria-hidden="true">
  <div class="bg-pattern"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
</div>

<div class="inv-pub-wrap">
  <div class="card inv-pub-head">
    <div>
      <h1 style="font-size:24px;font-weight:800;margin:0">Inventaris Pesantren SahabatQu</h1>
      <p class="cell-sub" style="margin-top:4px">Daftar barang publik — <%= list.length %> jenis · klik barang untuk melihat detail &amp; foto.</p>
    </div>
    <a class="btn btn-ghost" href=".">← Kembali ke Website</a>
  </div>

  <div class="tabs" style="margin-bottom:16px">
    <a class="<%- kat === '' ? 'active' : '' %>" href="inventaris">Semua</a>
    <% kategories.forEach(k => { %>
    <a class="<%- kat === k ? 'active' : '' %>" href="inventaris?kategori=<%= encodeURIComponent(k) %>"><%= k %></a>
    <% }) %>
  </div>

  <div class="inv-pub-grid">
    <% list.forEach(b => { %>
    <a class="card inv-pub-item" href="barang/<%= b.id %>">
      <div class="inv-pub-foto">
        <% if (b.foto) { %><img src="<%- e(b.foto) %>" alt="" loading="lazy" decoding="async"><% } else { %>
        <span>📦</span><% } %>
      </div>
      <div class="inv-pub-body">
        <strong><%= b.nama %></strong>
        <span class="cell-sub"><%= b.kategori || '—' %><% if (b.lokasi) { %> · <%= b.lokasi %><% } %></span>
        <span class="badge badge-<%= b.jumlah_tersedia > 0 ? 'green' : 'red' %>"><%= b.jumlah_tersedia %> / <%= b.jumlah_total %> <%= b.satuan %></span>
      </div>
    </a>
    <% }) %>
    <% if (list.length === 0) { %><p class="empty" style="grid-column:1/-1">Tidak ada barang pada kategori ini.</p><% } %>
  </div>
</div>
</body>
</html>
