<%- include('partials/head', { page: 'laporan' }) %>
<%
const ST_LABEL = { pending: 'Menunggu', disetujui: 'Disetujui', ditolak: 'Ditolak', selesai: 'Selesai', dibatalkan: 'Dibatalkan' };
%>
<div class="toolbar no-print">
  <a class="btn btn-ghost" href="<%- url('peminjaman-mobil') %>">← Kembali</a>
  <button type="button" class="btn" onclick="window.print()">🖨 Cetak / Simpan PDF</button>
  <a class="btn btn-ghost" href="<%- url('peminjaman-mobil/excel') %><%- filter ? '?status=' + filter : '' %>">⬇ Excel (CSV)</a>
</div>

<div class="print-header">
  <% if (logoData) { %>
  <img class="ph-logo ph-logo-img" src="<%- logoData %>" alt="Logo">
  <% } else { %>
  <svg class="ph-logo" viewBox="0 0 48 48" fill="none" aria-hidden="true">
    <path fill="#6366F1" d="M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z"/>
    <rect x="8" y="33" width="32" height="4" rx="2" fill="#8B5CF6"/>
    <rect x="4" y="38" width="40" height="5" rx="2.5" fill="#6366F1"/>
    <rect x="6" y="24" width="3" height="12" rx="1.5" fill="#E8C46A"/>
    <rect x="39" y="24" width="3" height="12" rx="1.5" fill="#E8C46A"/>
  </svg>
  <% } %>
  <div class="ph-text">
    <h2>PESANTREN SAHABATQU</h2>
    <p>Bagian Sarana &amp; Prasarana · Sistem Inventaris</p>
    <h3>Daftar Peminjaman Mobil / Kendaraan</h3>
    <span class="ph-date">Per <%= fmtDate(today()) %> · Dicetak <%= fmtDate(today()) %> oleh <%= u.nama %> · Status: <%- filter ? (ST_LABEL[filter] || filter) : 'Semua' %></span>
  </div>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th style="width:34px">No</th>
          <th>Mobil</th>
          <th>Plat</th>
          <th>Peminjam</th>
          <th>No. Telepon/WA</th>
          <th>Penumpang</th>
          <th>Keperluan</th>
          <th>Waktu</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% if (list.length === 0) { %>
        <tr><td colspan="9" class="empty-cell">Belum ada data peminjaman mobil<% if (filter) { %> pada status ini<% } %>.</td></tr>
        <% } %>
        <% list.forEach((r, i) => { %>
        <tr>
          <td><%= i + 1 %></td>
          <td><strong><%= r.mobil_nama %></strong><% if (r.mobil_jenis) { %><div class="cell-sub"><%= r.mobil_jenis %></div><% } %></td>
          <td><%= r.mobil_plat || '—' %></td>
          <td><%= r.peminjam_tampil %></td>
          <td><%= r.nomor_peminjam || '—' %></td>
          <td><%= r.jumlah_penumpang ? r.jumlah_penumpang + ' orang' : '—' %></td>
          <td><%= r.keperluan %></td>
          <td class="nowrap"><%= fmtDateShort(r.tanggal_mulai) %> – <%= fmtDateShort(r.tanggal_selesai) %><br><span class="cell-sub"><%= r.jam_mulai || '08:00' %> – <%= r.jam_selesai || '17:00' %> WIB</span></td>
          <td><%- badge(r.status, 'ruangan') %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="signature print-only">
  <div class="sig-block">
    <p class="sig-role">Dicetak oleh,</p>
    <p class="sig-name"><strong><%= u.nama %></strong></p>
    <p class="sig-sub"><%= roleLabel(u.role) %> · Pesantren SahabatQu</p>
  </div>
  <div class="sig-block">
    <p class="sig-role">Mengetahui,<br>Kepala Sarana &amp; Prasarana</p>
    <p class="sig-name">( &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; )</p>
  </div>
</div>

<%- include('partials/foot') %>
