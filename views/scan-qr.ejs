<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="robots" content="noindex">
<title>Scan QR Code — Pesantren SahabatQu</title>
<% if (logoData) { %>
<link rel="icon" href="<%- url('logo') %>">
<% } else { %>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236366F1'/%3E%3Cstop offset='1' stop-color='%238B5CF6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath fill='url(%23g)' d='M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z'/%3E%3Crect x='8' y='33' width='32' height='4' rx='2' fill='%238B5CF6'/%3E%3Crect x='4' y='38' width='40' height='5' rx='2.5' fill='%236366F1'/%3E%3Crect x='6' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3Crect x='39' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3C/svg%3E">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css?v=18">
<link rel="icon" type="image/png" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="icon" type="image/png" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<link rel="manifest" href="<%- url('manifest.webmanifest') %>">
<meta name="theme-color" content="#4F46E5">
<link rel="apple-touch-icon" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="apple-touch-icon" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SINTAPQU">
<script src="<%- url('pwa.js?v=6') %>" defer></script>
<style>
/* ---------- Pemindai QR (khusus halaman ini) ---------- */
.qs-wrap { max-width: 520px; margin: 0 auto; }
.qs-card {
  position: relative; border-radius: 20px; overflow: hidden;
  background: #05091F; border: 1px solid var(--line-strong);
  aspect-ratio: 3 / 4; max-height: 68vh;
  display: flex; align-items: center; justify-content: center;
}
.qs-card video { width: 100%; height: 100%; object-fit: cover; display: block; background: #05091F; }
.qs-idle { text-align: center; padding: 26px 20px; color: var(--ink-soft); }
.qs-idle svg { width: 62px; height: 62px; opacity: .75; }
.qs-idle p { margin-top: 12px; font-size: 13.5px; line-height: 1.6; }
.qs-frame { position: absolute; inset: 0; pointer-events: none; display: none; }
.qs-card.aktif .qs-frame { display: block; }
.qs-frame span { position: absolute; width: 42px; height: 42px; border: 3px solid #F5D98B; }
.qs-frame .tl { top: 14%; left: 12%; border-right: 0; border-bottom: 0; border-radius: 10px 0 0 0; }
.qs-frame .tr { top: 14%; right: 12%; border-left: 0; border-bottom: 0; border-radius: 0 10px 0 0; }
.qs-frame .bl { bottom: 14%; left: 12%; border-right: 0; border-top: 0; border-radius: 0 0 0 10px; }
.qs-frame .br { bottom: 14%; right: 12%; border-left: 0; border-top: 0; border-radius: 0 0 10px 0; }
.qs-laser {
  position: absolute; left: 12%; right: 12%; height: 2px; border-radius: 2px;
  background: linear-gradient(90deg, transparent, #F5D98B, transparent);
  box-shadow: 0 0 12px rgba(245, 217, 139, .9);
  animation: qsScan 2.2s ease-in-out infinite;
}
@keyframes qsScan { 0% { top: 16%; } 50% { top: 82%; } 100% { top: 16%; } }
.qs-status {
  margin-top: 14px; text-align: center; font-size: 13.5px; color: var(--ink-soft); min-height: 20px;
}
.qs-status.ok { color: #6EE7B7; font-weight: 700; }
.qs-status.err { color: var(--danger-text); font-weight: 600; }
.qs-btns { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; }
.qs-btns .btn { flex: 1 1 46%; justify-content: center; }
.qs-manual { margin-top: 20px; padding-top: 18px; border-top: 1px solid var(--line); }
.qs-manual h3 { font-size: 14px; font-weight: 800; margin-bottom: 8px; }
.qs-hint { font-size: 12px; color: var(--ink-mute); margin-top: 8px; line-height: 1.6; }
</style>
</head>
<body class="login-body">
<div class="bg" aria-hidden="true">
  <div class="bg-pattern"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
</div>

<div class="login-wrap qs-wrap" style="max-width:520px">
  <div class="card barang-publik">
    <div class="bp-head">
      <% if (logoData) { %><img class="bp-logo" src="<%- url('logo') %>" alt="Logo"><% } %>
      <span class="cell-sub">PESANTREN SAHABATQU</span>
    </div>
    <h1 class="bp-nama" style="font-size:21px;margin-top:6px">Scan QR Code</h1>
    <p class="cell-sub" style="text-align:center;margin-bottom:14px">
      Arahkan kamera ke <strong>QR pada stiker</strong> barang / ruangan — informasi akan langsung terbuka.
    </p>

    <div class="qs-card" id="qsCard">
      <video id="qsVideo" playsinline muted autoplay></video>
      <div class="qs-idle" id="qsIdle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
        <p>Kamera belum aktif.<br>Tekan <strong>Nyalakan Kamera</strong> di bawah, lalu izinkan akses kamera.</p>
      </div>
      <div class="qs-frame">
        <span class="tl"></span><span class="tr"></span><span class="bl"></span><span class="br"></span>
        <span class="qs-laser"></span>
      </div>
    </div>

    <p class="qs-status" id="qsStatus">Siap memindai…</p>

    <div class="qs-btns">
      <button type="button" class="btn" id="qsStart">📷 Nyalakan Kamera</button>
      <button type="button" class="btn btn-ghost" id="qsSwitch" hidden>🔄 Ganti Kamera</button>
    </div>
    <p class="qs-hint" id="qsHint">
      Catatan: kamera hanya bisa dipakai pada koneksi aman (<strong>https</strong>) dan setelah Anda menekan tombol izin kamera.
    </p>

    <div class="qs-manual">
      <h3>Tidak bisa scan? Ketik kode aset manual</h3>
      <form method="get" action="cek-barang" class="bp-scan">
        <input type="text" name="kode" placeholder="cth: 0303A Proyektor 082026 01">
        <button type="submit" class="btn">Cek</button>
      </form>
      <p class="qs-hint">Bisa juga mengetik kode stiker lama (cth: <strong>SBQ-00007</strong>).</p>
    </div>

    <a class="btn btn-ghost btn-block" style="margin-top:16px" href=".">← Kembali ke Menu Utama Website</a>
  </div>
</div>

<script src="<%- url('vendor/jsqr.js') %>"></script>
<script>
(function () {
  var video = document.getElementById('qsVideo');
  var card = document.getElementById('qsCard');
  var idle = document.getElementById('qsIdle');
  var statusEl = document.getElementById('qsStatus');
  var startBtn = document.getElementById('qsStart');
  var switchBtn = document.getElementById('qsSwitch');
  var stream = null;
  var timer = null;
  var facing = 'environment';   // kamera belakang dulu
  var kameraList = [];
  var idxKamera = 0;
  var selesai = false;
  var canvas = document.createElement('canvas');
  var ctx = canvas.getContext('2d', { willReadFrequently: true });

  function setStatus(teks, kelas) {
    statusEl.textContent = teks;
    statusEl.className = 'qs-status' + (kelas ? ' ' + kelas : '');
  }

  /* Ambil tujuan navigasi dari isi QR:
     - QR stiker kami berisi URL penuh (cth: https://.../barang/3 atau /ruangan/3)
     - QR berisi teks kode aset lain → arahkan ke halaman "cek kode" */
  function targetDari(teks) {
    var t = String(teks || '').trim();
    var path = '';
    try { var u = new URL(t); path = u.pathname + (u.search || ''); } catch (e) { path = ''; }
    if (path) {
      var mBarang = path.match(/\/barang\/(\d+)/i);
      if (mBarang) return 'barang/' + mBarang[1];
      var mRuangan = path.match(/\/ruangan\/(\d+)/i);
      if (mRuangan) return 'ruangan/' + mRuangan[1];
      var mCek = path.match(/cek-barang\?kode=([^&]+)/i);
      if (mCek) return 'cek-barang?kode=' + encodeURIComponent(decodeURIComponent(mCek[1]));
    }
    if (/^https?:\/\//i.test(t)) return '';            // URL luar yang tidak dikenal → jangan dibuka
    return 'cek-barang?kode=' + encodeURIComponent(t);  // anggap kode aset
  }

  function berhasil(teks) {
    if (selesai) return;
    var tujuan = targetDari(teks);
    if (!tujuan) {
      setStatus('QR terbaca tetapi bukan stiker inventaris: ' + teks, 'err');
      return;
    }
    selesai = true;
    setStatus('✓ QR terbaca — membuka data…', 'ok');
    if (navigator.vibrate) { try { navigator.vibrate(70); } catch (e) {} }
    setTimeout(function () { window.location.href = tujuan; }, 260);
  }

  function scan() {
    if (selesai || !stream) return;
    if (video.readyState === video.HAVE_ENOUGH_DATA && video.videoWidth) {
      var w = video.videoWidth, h = video.videoHeight;
      var skala = Math.min(1, 720 / Math.max(w, h));   // perkecil agar cepat di HP
      canvas.width = Math.round(w * skala);
      canvas.height = Math.round(h * skala);
      ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
      try {
        var data = ctx.getImageData(0, 0, canvas.width, canvas.height);
        var hasil = window.jsQR ? window.jsQR(data.data, data.width, data.height, { inversionAttempts: 'dontInvert' }) : null;
        if (hasil && hasil.data) { berhasil(hasil.data); return; }
      } catch (e) { /* lanjut saja */ }
    }
    timer = setTimeout(scan, 180);
  }

  function stopKamera() {
    if (timer) { clearTimeout(timer); timer = null; }
    if (stream) { stream.getTracks().forEach(function (t) { t.stop(); }); stream = null; }
    card.classList.remove('aktif');
  }

  var kameras = [];
  function pilihKamera() {
    if (!kameras.length) return { video: { facingMode: { ideal: facing } }, audio: false };
    // utamakan kamera belakang bila tersedia
    var belakang = kameras.filter(function (d) { return /back|rear|belakang|environment/i.test(d.label); });
    var d = belakang[0] || kameras[idxKamera] || kameras[0];
    return { video: { deviceId: { exact: d.deviceId } }, audio: false };
  }

  function mulai() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      setStatus('Browser ini tidak mendukung akses kamera. Silakan ketik kode secara manual di bawah.', 'err');
      return;
    }
    if (!window.isSecureContext) {
      setStatus('Kamera hanya bisa dipakai pada alamat https. Silakan ketik kode manual di bawah.', 'err');
      return;
    }
    setStatus('Meminta izin kamera…');
    stopKamera();
    navigator.mediaDevices.getUserMedia(pilihKamera()).then(function (s) {
      stream = s;
      video.srcObject = s;
      video.setAttribute('playsinline', '');
      var play = video.play();
      if (play && play.catch) play.catch(function () {});
      card.classList.add('aktif');
      if (idle) idle.style.display = 'none';
      setStatus('Kamera aktif — arahkan ke QR code…');
      selesai = false;
      scan();
    }).catch(function (err) {
      var pesan = 'Tidak dapat membuka kamera.';
      if (err && err.name === 'NotAllowedError') pesan = 'Akses kamera ditolak. Izinkan kamera pada browser, lalu tekan Nyalakan Kamera lagi.';
      else if (err && err.name === 'NotFoundError') pesan = 'Tidak ada kamera yang terdeteksi pada perangkat ini.';
      else if (err && err.name === 'NotReadableError') pesan = 'Kamera sedang dipakai aplikasi lain. Tutup aplikasi tersebut lalu coba lagi.';
      setStatus(pesan, 'err');
    });
  }

  /* Daftar kamera (label hanya terisi setelah izin diberikan) */
  function muatDaftarKamera() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.enumerateDevices) return;
    navigator.mediaDevices.enumerateDevices().then(function (ds) {
      kameras = ds.filter(function (d) { return d.kind === 'videoinput'; });
      if (kameras.length > 1) switchBtn.hidden = false;
    }).catch(function () {});
  }

  startBtn.addEventListener('click', function () { muatDaftarKamera(); mulai(); });
  switchBtn.addEventListener('click', function () {
    if (kameras.length < 2) return;
    idxKamera = (idxKamera + 1) % kameras.length;
    facing = /back|rear|belakang|environment/i.test(kameras[idxKamera].label) ? 'environment' : 'user';
    mulai();
  });

  // Coba nyalakan otomatis (browser modern akan meminta izin; bila butuh gestur, tombol tetap tersedia)
  if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia && window.isSecureContext) {
    window.setTimeout(function () { mulai(); }, 350);
  } else if (!window.isSecureContext) {
    setStatus('Halaman ini tidak diakses lewat https — kamera tidak dapat dibuka. Gunakan kolom kode manual di bawah.', 'err');
  }
  window.addEventListener('pagehide', stopKamera);
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { if (timer) { clearTimeout(timer); timer = null; } }
    else if (stream && !timer && !selesai) { scan(); }
  });
})();
</script>
</body>
</html>
