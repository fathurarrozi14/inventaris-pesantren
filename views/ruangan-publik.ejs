<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="robots" content="noindex">
<title><%= e(ruangan.nama) %> — Pesantren SahabatQu</title>
<% if (logoData) { %>
<link rel="icon" href="<%- url('logo') %>">
<% } else { %>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236366F1'/%3E%3Cstop offset='1' stop-color='%238B5CF6'/%3E%3C/linearGradient%3E%3C/defs%3E%3Cpath fill='url(%23g)' d='M24 5C17 11 13 16 13 22c0 7 5 11 11 11s11-4 11-11c0-6-4-11-11-17z'/%3E%3Crect x='8' y='33' width='32' height='4' rx='2' fill='%238B5CF6'/%3E%3Crect x='4' y='38' width='40' height='5' rx='2.5' fill='%236366F1'/%3E%3Crect x='6' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3Crect x='39' y='24' width='3' height='12' rx='1.5' fill='%23E8C46A'/%3E%3C/svg%3E">
<% } %>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="<%- url('style.css?v=18') %>">
<link rel="icon" type="image/png" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="icon" type="image/png" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<link rel="manifest" href="<%- url('manifest.webmanifest') %>">
<meta name="theme-color" content="#4F46E5">
<link rel="apple-touch-icon" sizes="192x192" href="<%- url('ikon-192.png?v=' + logoVer) %>">
<link rel="apple-touch-icon" sizes="512x512" href="<%- url('ikon-512.png?v=' + logoVer) %>">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="SINTAPQU">
<script src="<%- url('pwa.js?v=6') %>" defer></script>
</head>
<body class="login-body">
<div class="bg" aria-hidden="true">
  <div class="bg-pattern"></div>
  <div class="orb orb-1"></div>
  <div class="orb orb-2"></div>
</div>

<div class="login-wrap" style="max-width:520px">
  <div class="card barang-publik">
    <div class="bp-head">
      <% if (logoData) { %><img class="bp-logo" src="<%- url('logo') %>" alt="Logo"><% } %>
      <span class="cell-sub">PESANTREN SAHABATQU · Sistem Inventaris</span>
    </div>
    <div class="bp-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" style="width:64px;height:64px"><path d="M13 4h3a2 2 0 0 1 2 2v14"/><path d="M2 20h3"/><path d="M13 20h9"/><path d="M10 12v.01"/></svg>
    </div>
    <h1 class="bp-nama"><%= e(ruangan.nama) %></h1>
    <div class="bp-kode"><span class="kat kat-sarana">Ruangan</span></div>
    <div class="bp-meta">
      <div class="meta"><span>Lokasi</span><strong><%= ruangan.lokasi || '—' %></strong></div>
      <div class="meta"><span>Kapasitas</span><strong><%= ruangan.kapasitas %> orang</strong></div>
      <div class="meta"><span>Golongan</span><strong><%= ruangan.golongan || '—' %></strong></div>
      <div class="meta"><span>Bidang</span><strong><%= ruangan.bidang_aset || '—' %></strong></div>
      <div class="meta"><span>Kode</span><strong><%= ruangan.kode_aset || '—' %></strong></div>
      <div class="meta"><span>Status</span><strong><%= statusLabel(ruangan.status, 'ruangan') %></strong></div>
    </div>
    <% if (ruangan.deskripsi) { %><p class="bp-desc"><%= ruangan.deskripsi %></p><% } %>
    <div class="bp-actions">
      <a class="btn" href="..">☰ Menu Utama</a>
      <a class="btn btn-ghost" href="../peminjaman-ruangan">Pinjam Ruangan</a>
      <a class="btn btn-ghost" href="../cek-barang">Cek Kode Lain</a>
    </div>
  </div>
</div>
</body>
</html>
